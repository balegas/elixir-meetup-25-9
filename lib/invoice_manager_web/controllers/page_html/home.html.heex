<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <header class="bg-white border-b border-gray-200 px-6 py-4">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <h1 class="text-2xl font-semibold text-gray-900">Invoice Manager</h1>
      <button class="text-sm text-gray-600 hover:text-gray-900">Logout</button>
    </div>
  </header>
  
<!-- Main Content -->
  <main class="max-w-6xl mx-auto px-6 py-8">
    <!-- Navigation Tabs -->
    <nav class="flex space-x-8 mb-8">
      <button class="text-blue-600 border-b-2 border-blue-600 pb-2 font-medium">
        All Invoices
      </button>
      <button class="text-gray-500 hover:text-gray-700 pb-2">Recurring</button>
      <button class="text-gray-500 hover:text-gray-700 pb-2">Monthly Checklist</button>
    </nav>
    
<!-- Filters -->
    <div class="flex items-center gap-4 mb-6">
      <select class="px-3 py-2 border border-gray-300 rounded-md text-sm bg-white">
        <option>All Months</option>
        <option>December 2024</option>
        <option>November 2024</option>
      </select>
      <select class="px-3 py-2 border border-gray-300 rounded-md text-sm bg-white">
        <option>All Types</option>
        <option>Recurring</option>
        <option>One-time</option>
      </select>
      <input
        type="text"
        placeholder="Search invoices..."
        class="px-3 py-2 border border-gray-300 rounded-md text-sm flex-1"
      />
    </div>
    
<!-- Upload Area -->
    <div class="mb-8 p-8 border-2 border-dashed border-gray-300 rounded-lg text-center bg-white">
      <div class="text-gray-500">
        <svg class="mx-auto h-12 w-12 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
          />
        </svg>
        <p class="text-lg mb-2">Drop invoice files here or click to upload</p>
        <p class="text-sm">PDF, JPG, PNG files supported</p>
      </div>
    </div>
    
<!-- Invoice List -->
    <div class="bg-white rounded-lg border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Recent Invoices</h2>
      </div>
      
<!-- Sample invoices -->
      <div class="divide-y divide-gray-200">
        <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
          <div class="flex-1">
            <div class="flex items-center gap-3">
              <h3 class="font-medium text-gray-900">Electricity Bill</h3>
              <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                Recurring
              </span>
              <span class="px-2 py-1 text-xs bg-gray-100 text-gray-800 rounded-full">
                Utilities
              </span>
            </div>
            <p class="text-sm text-gray-500 mt-1">Due: December 15, 2024 • $125.00</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 text-xs bg-green-100 text-green-800 rounded-full">Paid</span>
            <button class="text-blue-600 hover:text-blue-800 text-sm">View</button>
          </div>
        </div>

        <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
          <div class="flex-1">
            <div class="flex items-center gap-3">
              <h3 class="font-medium text-gray-900">Internet Service</h3>
              <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                Recurring
              </span>
              <span class="px-2 py-1 text-xs bg-gray-100 text-gray-800 rounded-full">
                Utilities
              </span>
            </div>
            <p class="text-sm text-gray-500 mt-1">Due: December 20, 2024 • $89.99</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 text-xs bg-yellow-100 text-yellow-800 rounded-full">
              Pending
            </span>
            <button class="text-blue-600 hover:text-blue-800 text-sm">View</button>
          </div>
        </div>

        <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
          <div class="flex-1">
            <div class="flex items-center gap-3">
              <h3 class="font-medium text-gray-900">Office Supplies</h3>
              <span class="px-2 py-1 text-xs bg-gray-100 text-gray-800 rounded-full">
                Business
              </span>
            </div>
            <p class="text-sm text-gray-500 mt-1">Due: December 10, 2024 • $245.50</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 text-xs bg-green-100 text-green-800 rounded-full">Paid</span>
            <button class="text-blue-600 hover:text-blue-800 text-sm">View</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

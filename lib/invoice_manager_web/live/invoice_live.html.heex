<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 px-6 py-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-gray-900">Invoice Manager</h1>
        <a href="/logout" class="text-sm text-gray-600 hover:text-gray-900">Logout</a>
      </div>
    </header>
    
<!-- Main Content -->
    <main class="max-w-6xl mx-auto px-6 py-8">
      <!-- Navigation Tabs -->
      <nav class="flex space-x-8 mb-8">
        <button class="text-blue-600 border-b-2 border-blue-600 pb-2 font-medium">
          All Invoices
        </button>
        <button class="text-gray-500 hover:text-gray-700 pb-2">Recurring</button>
        <button class="text-gray-500 hover:text-gray-700 pb-2">Monthly Checklist</button>
      </nav>
      
<!-- Filters -->
      <form phx-change="filter" class="flex items-center gap-4 mb-6">
        <select
          name="filters[month]"
          class="px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900"
        >
          <option value="">All Months</option>
          <option value="12">December 2024</option>
          <option value="11">November 2024</option>
          <option value="10">October 2024</option>
        </select>
        <select
          name="filters[recurring]"
          class="px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900"
        >
          <option value="">All Types</option>
          <option value="true">Recurring</option>
          <option value="false">One-time</option>
        </select>
        <input
          name="filters[search]"
          type="text"
          placeholder="Search invoices..."
          value={@filters["search"] || ""}
          class="px-3 py-2 border border-gray-300 rounded-md text-sm flex-1 bg-white text-gray-900 placeholder-gray-400"
        />
      </form>
      
<!-- Add Invoice Button -->
      <div class="mb-6">
        <button
          phx-click="toggle_form"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium"
        >
          Add New Invoice
        </button>
      </div>
      
<!-- Add Invoice Form -->
      <div :if={@show_form} class="mb-8 bg-white rounded-lg border border-gray-200 p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Add New Invoice</h3>

        <.form
          for={@form}
          phx-change="validate_invoice"
          phx-submit="save_invoice"
          id="invoice-form"
          class="space-y-4"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Invoice Name</label>
              <.input
                field={@form[:name]}
                type="text"
                placeholder="e.g., Electricity Bill"
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900 placeholder-gray-400 focus:ring-blue-500 focus:border-blue-500"
                error_class="border-red-400 focus:border-red-500 focus:ring focus:ring-red-300"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Amount</label>
              <.input
                field={@form[:amount]}
                type="number"
                step="0.01"
                placeholder="0.00"
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900 placeholder-gray-400 focus:ring-blue-500 focus:border-blue-500"
                error_class="border-red-400 focus:border-red-500 focus:ring focus:ring-red-300"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Due Day (1-31)</label>
              <.input
                field={@form[:due_day]}
                type="number"
                min="1"
                max="31"
                placeholder="15"
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900 placeholder-gray-400 focus:ring-blue-500 focus:border-blue-500"
                error_class="border-red-400 focus:border-red-500 focus:ring focus:ring-red-300"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Tags (comma separated)
              </label>
              <.input
                field={@form[:tags]}
                type="text"
                placeholder="utilities, monthly"
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900 placeholder-gray-400 focus:ring-blue-500 focus:border-blue-500"
                error_class="border-red-400 focus:border-red-500 focus:ring focus:ring-red-300"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              <.input field={@form[:is_recurring]} type="checkbox" class="mr-2" />
              Recurring Invoice
            </label>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <.input
              field={@form[:description]}
              type="textarea"
              placeholder="Optional description..."
              class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm bg-white text-gray-900 placeholder-gray-400 focus:ring-blue-500 focus:border-blue-500"
              error_class="border-red-400 focus:border-red-500 focus:ring focus:ring-red-300"
            />
          </div>
          
<!-- File Upload -->
          <div
            class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center bg-gray-50"
            phx-drop-target={@uploads.invoice_file.ref}
          >
            <svg
              class="mx-auto h-12 w-12 text-gray-400 mb-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
              />
            </svg>
            <div class="text-gray-600">
              <label for={@uploads.invoice_file.ref} class="cursor-pointer">
                <span class="text-blue-600 hover:text-blue-700 font-medium">Click to upload</span>
                <span class="text-gray-500"> or drag and drop</span>
              </label>
              <.live_file_input upload={@uploads.invoice_file} class="hidden" />
            </div>
            <p class="text-xs text-gray-500 mt-2">PDF, JPG, PNG files up to 10MB</p>
          </div>

          <div class="flex justify-end space-x-3">
            <button
              type="button"
              phx-click="toggle_form"
              class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-4 py-2 bg-blue-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-blue-700"
            >
              Save Invoice
            </button>
          </div>
        </.form>
      </div>
      
<!-- Invoice List -->
      <div class="bg-white rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Invoices</h2>
        </div>

        <div :if={@invoices == []} class="px-6 py-8 text-center text-gray-500">
          No invoices found. Add your first invoice above!
        </div>

        <div :if={@invoices != []} class="divide-y divide-gray-200">
          <div
            :for={invoice <- @invoices}
            class="px-6 py-4 flex items-center justify-between hover:bg-gray-50"
          >
            <div class="flex-1">
              <div class="flex items-center gap-3">
                <h3 class="font-medium text-gray-900">{invoice.name}</h3>
                <span
                  :if={invoice.is_recurring}
                  class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full"
                >
                  Recurring
                </span>
                <span
                  :for={tag <- invoice.tags || []}
                  class="px-2 py-1 text-xs bg-gray-100 text-gray-800 rounded-full"
                >
                  {tag}
                </span>
              </div>
              <p class="text-sm text-gray-500 mt-1">
                {if invoice.due_day, do: "Due: Day #{invoice.due_day}"}
                {if invoice.amount, do: " • #{format_currency(invoice.amount)}"}
              </p>
              <p :if={invoice.description} class="text-sm text-gray-400 mt-1">
                {invoice.description}
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button
                phx-click="delete_invoice"
                phx-value-id={invoice.id}
                data-confirm="Are you sure you want to delete this invoice?"
                class="text-red-600 hover:text-red-800 text-sm"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layouts.app>
